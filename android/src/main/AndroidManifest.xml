<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- From Android 11, an app only sees the text-to-speech engines it
         declares it looks for; merged into the app's manifest. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
